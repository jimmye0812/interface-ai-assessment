{
  "name": "ui-capability-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "schema": "tsx scripts/schema.ts",
    "discover:secure": "tsx scripts/live.ts",
    "evidence": "tsx scripts/evidence.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "1.55.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "prettier": "3.5.3",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "zod-to-json-schema": "3.24.5"
  }
}
